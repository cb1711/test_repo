  filters:
  - column:
    - TPCH WS::Category
    oper: in
    values:
    - mfgr#12
    - mfgr#14
    - mfgr#22
    - mfgr#24
    is_mandatory: false
    is_single_value: false
    display_name: ""
  - column:
    - TPCH WS::Commit Date
    is_mandatory: false
    date_filter:
      type: EXACT_DATE_RANGE
      oper: between
      date_range:
        start_date: 07/18/1996
        end_date: 10/29/1998
    display_name: ""
  - column:
    - TPCH WS::Tax
    oper: '>='
    values:
    - "5"
    is_mandatory: false
    is_single_value: false
    display_name: ""
  - column:
    - TPCH WS::Ship Mode
    oper: in
    values:
    - air
    - fob
    is_mandatory: false
    is_single_value: false
    display_name: ""
  - column:
    - TPCH WS::Brand1
    is_mandatory: false
    is_single_value: false
    display_name: ""
  - column:
    - TPCH WS::Customer Region
    oper: in
    values:
    - asia
    - europe
    - middle east
    is_mandatory: false
    is_single_value: false
    display_name: ""
  - column:
    - TPCH WS::the month formula
    oper: in
    values:
    - january
    - february
    - march
    - july
    - may
    - october
    is_mandatory: false
    is_single_value: false
    display_name: ""
  - column:
    - TPCH WS::Container
    oper: in
    values:
    - "{null}"
    - jumbo bag
    - jumbo box
    - jumbo can
    - jumbo jar
    - lg bag
    - lg can
    - sm box
    - sm can
    - wrap box
    - wrap drum
    - wrap pkg
    is_mandatory: false
    is_single_value: false
    display_name: ""
